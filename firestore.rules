rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (after `firebase init firestore` in this project, using the Firebase
// project you created for MamaSalama)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isHospital() {
      return signedIn() && myRole() == 'hospital';
    }

    // True if the caller is the CHW assigned to the given mother.
    function isAssignedChwFor(motherId) {
      return signedIn() && myRole() == 'chw' &&
        get(/databases/$(database)/documents/users/$(motherId)).data.assignedChwId == request.auth.uid;
    }

    // ---- users/{uid} : AppUser docs (mother / chw / admin) ----
    // Also holds a `pregnancyProfile` map field, covered by the same
    // read/update rules as the rest of the doc.
    match /users/{uid} {
      // Any signed-in user can read their own doc; CHW/Admin/Hospital
      // dashboards need to read every user (assigning CHWs, hospital
      // referral pickers, etc). A mother is scoped to her own doc plus any
      // CHW doc (to show her care team's name on the dashboard) — NOT other
      // mothers', which would otherwise leak pregnancyProfile (due date,
      // blood type, allergies, high-risk flag) to anyone who learns another
      // mother's uid (e.g. via a community post's authorId).
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        myRole() == 'chw' ||
        myRole() == 'admin' ||
        myRole() == 'hospital' ||
        resource.data.role == 'chw'
      );
      // Anyone can create their own account doc on signup.
      allow create: if signedIn() && request.auth.uid == uid;
      // A user can update their own doc, but not their own `role` — that
      // field only moves via an admin action (assigning a CHW to a mother
      // is a separate `assignedChwId` field on the mother's own doc, not
      // `role`, so this doesn't block that). Without this restriction any
      // signed-in user (in particular a chwApplicant awaiting review)
      // could just self-write `role: 'chw'` and skip the whole approval
      // flow in ChwApplicationScreen / AdminShell.
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // ---- users/{uid}/vitals/{yyyy-MM-dd} : DailyVitals docs ----
      // A mother owns her own daily logs; her assigned CHW or any admin
      // can read (never write) them.
      match /vitals/{date} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow read: if signedIn() && (
          isAdmin() ||
          (myRole() == 'chw' && get(/databases/$(database)/documents/users/$(uid)).data.assignedChwId == request.auth.uid)
        );
      }
    }

    // ---- helpRequests/{id} : SOS + "I need help" requests ----
    match /helpRequests/{id} {
      // Broad for CHW/Admin so a CHW can see the unassigned pool and an
      // admin can see everything; a mother is scoped to her own requests —
      // she has no legitimate reason to read another mother's SOS message
      // text, and nothing in the app queries this collection as a mother
      // today, so this was a pure latent leak, not a used broad-read path.
      allow read: if signedIn() && (
        resource.data.motherId == request.auth.uid ||
        myRole() == 'chw' ||
        isAdmin()
      );
      allow create: if signedIn() && request.resource.data.motherId == request.auth.uid;
      // Mother can cancel her own request; CHW can claim/resolve; admin can
      // assign/resolve any.
      allow update: if signedIn() && (
        resource.data.motherId == request.auth.uid ||
        myRole() == 'chw' ||
        isAdmin()
      );
    }

    // ---- appointments/{id} : booked visits ----
    match /appointments/{id} {
      function isAssignedChw() {
        return myRole() == 'chw' &&
          get(/databases/$(database)/documents/users/$(resource.data.motherId)).data.assignedChwId == request.auth.uid;
      }
      allow read: if signedIn() && (resource.data.motherId == request.auth.uid || isAssignedChw() || isAdmin() || isHospital());
      allow create: if signedIn() && request.resource.data.motherId == request.auth.uid;
      allow update: if signedIn() && (resource.data.motherId == request.auth.uid || isAdmin());
    }

    // ---- reminders/{id} : one per booked appointment, read by the owning
    // mother; not yet consumed by anything (hook for a future notification
    // job) ----
    match /reminders/{id} {
      allow read: if signedIn() && resource.data.motherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.motherId == request.auth.uid;
    }

    // ---- medicalRecords/{id}, labResults/{id}, vaccineRecords/{id} ----
    // Written only by a CHW for one of their assigned mothers (or an
    // admin); a mother can only ever read her own — no create/update.
    match /medicalRecords/{id} {
      allow read: if signedIn() && (resource.data.motherId == request.auth.uid || isAssignedChwFor(resource.data.motherId) || isAdmin() || isHospital());
      allow create: if signedIn() && (isAssignedChwFor(request.resource.data.motherId) || isAdmin());
    }

    match /labResults/{id} {
      allow read: if signedIn() && (resource.data.motherId == request.auth.uid || isAssignedChwFor(resource.data.motherId) || isAdmin() || isHospital());
      allow create: if signedIn() && (isAssignedChwFor(request.resource.data.motherId) || isAdmin());
    }

    match /vaccineRecords/{id} {
      allow read: if signedIn() && (resource.data.motherId == request.auth.uid || isAssignedChwFor(resource.data.motherId) || isAdmin() || isHospital());
      allow create: if signedIn() && (isAssignedChwFor(request.resource.data.motherId) || isAdmin());
    }

    // ---- referrals/{id} : CHW -> Hospital, generated alongside a
    // referral letter PDF (see report_service.dart) ----
    match /referrals/{id} {
      allow read: if signedIn() && (
        resource.data.chwId == request.auth.uid ||
        resource.data.hospitalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() &&
        isAssignedChwFor(request.resource.data.motherId) &&
        request.resource.data.chwId == request.auth.uid;
    }

    // ---- educationContent/{id} : lessons, written by Admins only ----
    match /educationContent/{id} {
      allow read: if signedIn();
      allow create: if isAdmin();
    }

    // ---- communityGroups/{id} + posts subcollection ----
    // Groups are seeded once outside the app (console/admin script) —
    // there's no in-app "create group" flow. Posts can be made by any
    // signed-in mother or CHW; isExpertAnswer must match the poster's real
    // role, not just whatever the client claims.
    match /communityGroups/{groupId} {
      allow read: if signedIn();
      allow create: if isAdmin();

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.isExpertAnswer == (myRole() == 'chw');
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // ---- chatThreads/{threadId} + messages subcollection ----
    // threadId is always "<uidA>_<uidB>" sorted, so a participant's own
    // uid is always one of the two underscore-separated segments.
    match /chatThreads/{threadId} {
      function isParticipant() {
        return request.auth.uid in threadId.split('_');
      }
      // Reads (including the list query behind watchMyThreads) are gated
      // on the `participants` field rather than isParticipant(): Firestore
      // only allows a list/collection query when the rule checks the same
      // field the query itself filters on, not just the document ID.
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      // Writes always target one already-known threadId (create or
      // merge-update from sendMessage), so the doc-ID-based check is fine
      // even before the document — and its `participants` field — exists.
      allow write: if signedIn() && isParticipant();

      match /messages/{messageId} {
        allow read: if signedIn() && isParticipant();
        allow create: if signedIn() && isParticipant() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
